# Sample environment variables for mp-backend on DigitalOcean App Platform.
# Copy the KEY=VALUE lines below (without this header) into the app's
# Settings > App-Level Environment Variables > Bulk Editor, fill in the
# placeholder values, and mark secrets as "Encrypted".
#
# Do not commit a real, filled-in copy of this file.

# --- MongoDB -----------------------------------------------------------
# Rotate the credentials before use - the value that used to live in
# application.yml was committed in plaintext and must be treated as leaked.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=<database-name>

# --- JWT auth ------------------------------------------------------------
# Example below is a freshly generated 256-bit secret (openssl rand -hex 32).
# Generate your own and mark it Encrypted - never reuse this sample value.
JWT_SECRET_KEY=02346b93aa19f1cdfe7a2c3d0ffc057abe74ab322d542ee334879b1ec47db70b
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- File storage (GCP) --------------------------------------------------
FILE_STORAGE_PROVIDER=gcp
FILE_STORAGE_BUCKET=<gcs-bucket-name>
# Full service-account JSON as a single-line string, e.g.:
# {"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...", ...}
GOOGLE_CLOUD_PLATFORM_CREDENTIALS=<service-account-json>

# --- Brevo (transactional email) -----------------------------------------
BREVO_API_KEY=<brevo-api-key>
BREVO_EMAIL_FROM=no-reply@yourdomain.com

# --- Server ---------------------------------------------------------------
# PORT is injected automatically by DigitalOcean App Platform - do not set it.
